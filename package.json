{
  "name": "savlivo-mvp",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace @savlivo/api run dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "mobile:start": "npm --workspace @savlivo/mobile run start"
  },
  "dependencies": {
    "expo-web-browser": "~15.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native-safe-area-context": "~5.6.0"
  }
}
