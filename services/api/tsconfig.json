{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "../../packages/**/*.ts",
    "src/research-v1/**/*.mjs"
  ],
  "exclude": [
    "src/savlivo-*-build-*.ts"
  ]
}
