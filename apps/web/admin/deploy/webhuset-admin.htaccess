# ADMIN SUBDOMAIN ONLY: install as /subdomener/admin/.htaccess after separate approval.
# Requires Apache 2.4, mod_rewrite, mod_headers and the corresponding AllowOverride.
# No IfModule fallbacks: unavailable security directives must fail closed.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On
RewriteCond %{HTTP_HOST} !^admin\.savlivo\.com$ [NC]
RewriteRule ^ - [F,L]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://admin.savlivo.com%{REQUEST_URI} [R=301,L]
# Upload only the three public client files. Deny unexpected files even if uploaded.
RewriteRule !^(index\.html|admin\.js|admin\.css)?$ - [F,L]

Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://savlivo-api.onrender.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
Header always set Cache-Control "no-store"
# Admin hostname only. No includeSubDomains or preload commitment.
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
