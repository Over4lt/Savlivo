{
  "expo": {
    "name": "Savlivo",
    "slug": "savlivo",
    "scheme": "savlivo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thomashodne.savlivo",
      "icon": "./assets/logo.png"
    },
    "android": {
      "package": "com.thomashodne.savlivo",
      "icon": "./assets/logo.png",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "icon": "./assets/logo.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64dfe0f7-e0e6-48c2-96d7-bdb74f341af7"
      }
    },
    "owner": "overalt"
  }
}
